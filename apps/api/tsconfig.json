{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "lib": ["ESNext"],
    // Runtime globals (D1Database, fetch types, …) come from the generated
    // worker-configuration.d.ts (`pnpm cf-typegen` — rerun after changing
    // wrangler.jsonc). Do NOT add @cloudflare/workers-types here: wrangler's
    // generated runtime types replace it and the two sources drift apart.
    // The pool types add the `cloudflare:test` module for the test suite.
    "types": ["@cloudflare/vitest-pool-workers/types"]
  }
}
