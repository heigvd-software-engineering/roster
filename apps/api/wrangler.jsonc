{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ONE Worker serves BOTH the SPA (static assets) and /api/* on a single
  // origin — https://roster.y-software.ch — so Better Auth cookies stay
  // first-party. There is ONE environment: production is this top-level
  // config. `wrangler dev` runs the same config locally and reads
  // apps/api/.dev.vars for the secrets AND the two dev-only var overrides
  // (BETTER_AUTH_URL, GITHUB_APP_SLUG) — values in .dev.vars win over the
  // `vars` below during `wrangler dev`. See apps/api/.dev.vars.example.
  "name": "roster-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],

  // The custom domain. Requires the y-software.ch zone on the deploying
  // account. `wrangler dev` ignores routes and serves on localhost.
  "routes": [{ "pattern": "roster.y-software.ch", "custom_domain": true }],

  "assets": {
    "directory": "../www/build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Browser *navigations* to /api/* (Sec-Fetch-Mode: navigate) must reach
    // the Worker first, not the SPA fallback — otherwise the OAuth callback
    // never hits Hono/Better Auth.
    "run_worker_first": ["/api/*"]
  },

  // Public, non-secret config. Secrets are set once per deploy with
  //   wrangler secret put <KEY>            (see DEPLOY.md)
  // and, for local dev, in apps/api/.dev.vars (which also overrides
  // BETTER_AUTH_URL + GITHUB_APP_SLUG with their localhost/dev values).
  "vars": {
    "BETTER_AUTH_URL": "https://roster.y-software.ch",
    "EDUID_ISSUER": "https://login.eduid.ch",
    // The GitHub App's public slug (install URL path segment) — delivered to
    // the SPA via /api/me. Fill in after creating the App (GITHUB_APP_SETUP.md).
    "GITHUB_APP_SLUG": "<app-slug>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roster-db",
      // Create it once with `wrangler d1 create roster-db` and paste the id
      // here. All-zeros is a deliberately invalid placeholder so a premature
      // remote deploy fails loudly. Ignored for local dev, where miniflare
      // keeps its own sqlite under .wrangler/.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
