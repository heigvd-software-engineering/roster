{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labs",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  // PROD values — `.dev.vars` overrides these for local `wrangler dev`
  // (see DEPLOY.md phase 2).
  "vars": {
    "BETTER_AUTH_URL": "https://labs.stefan-teofanov.workers.dev",
    "EDUID_ISSUER": "https://login.eduid.ch",
    // The DEMO GitHub App's public slug (install URL path segment) — public
    // config, not a secret. Delivered to the SPA via /api/me. Dev overrides
    // to its own App (`heigvdlabs`) in .dev.vars — one App per environment
    // (GITHUB_APP_SETUP.md).
    "GITHUB_APP_SLUG": "heigvdlabsdemo"
  },
  "assets": {
    "directory": "../www/build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API routes must hit the Worker first. Without this, browser *navigations*
    // (Sec-Fetch-Mode: navigate) to /api/* are short-circuited by the SPA
    // not_found_handling and never reach Hono/Better Auth (breaks OAuth callback).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labs",
      // The remote db on the demo Cloudflare account (DEPLOY.md). Local dev
      // ignores the id — miniflare keeps its own local sqlite.
      "database_id": "1dd57ff0-73c3-439a-8878-df578944cfe1",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
